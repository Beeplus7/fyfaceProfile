{
  "name": "my-face-profile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "marketing": "npm --prefix apps/marketing run dev",
    "marketing:build": "npm --prefix apps/marketing run build",
    "typecheck": "tsc --noEmit",
    "dev": "turbo run dev --parallel",
    "dev:marketing": "pnpm --filter @myface/marketing dev",
    "dev:web": "pnpm --filter @myface/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.15.0"
}
