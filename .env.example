# MyFace — public client vars (safe for Expo / Vite)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_URL=https://myfaceprofile.aikova.co.uk
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=https://myfaceprofile.aikova.co.uk
VITE_JAMENDO_CLIENT_ID=your-jamendo-client-id
VITE_YOUTUBE_API_KEY=your-youtube-data-api-key

# Server-only — NEVER prefix with EXPO_PUBLIC_ or VITE_
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# SUPABASE_ACCESS_TOKEN=
# JAMENDO_CLIENT_SECRET=
